[Unit]
Description=PostgreSQL SwingTrader Database Backup
After=network.target docker.service

[Service]
Type=oneshot
User=dikesh
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/scripts/backup-postgres.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swingtrader-backup

[Install]
WantedBy=multi-user.target
