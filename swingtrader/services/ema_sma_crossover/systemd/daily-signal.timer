[Unit]
Description=Daily EMA(10)/SMA(40) Signal Timer (weekdays at 4:30 PM ET)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target postgresql.service

[Timer]
OnCalendar=Mon..Fri *-*-* 16:30:00 America/New_York
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
