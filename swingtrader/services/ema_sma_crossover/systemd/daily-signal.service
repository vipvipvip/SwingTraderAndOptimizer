[Unit]
Description=Daily EMA(10)/SMA(40) Signal Service (run once after market close)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target postgresql.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/ema_sma_crossover
ExecStart=/usr/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/ema_sma_crossover/daily_signal_service.py
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
