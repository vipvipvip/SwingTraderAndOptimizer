[Unit]
Description=MTF emasma Stock+ETF Executor (score retried until market close, then execute)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network-online.target swingtrader-db.service swingtrader-scanner-backfill.service
Wants=network-online.target

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf
# executor_retry.py: retry the score step (both legs) every 30m until it has all
# the tickers' data or 16:00 ET, then run the execute step once. It exits as soon
# as it is done, and never starts a new attempt at/after the close, so the 16:45
# recap scorer and tomorrow's 10:25 trigger are never blocked by a live retry
# loop (systemd will not re-trigger a unit that is still active).
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf/executor_retry.py
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=120
# Backstop: Type=oneshot defaults TimeoutStartSec to infinity, so pin it — a
# 10:25 trigger is killed by 16:25 even if the retry loop misbehaves. (RuntimeMaxSec
# is ignored for oneshot units.)
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
