[Unit]
Description=S1 ETF Daily Executor (10:25 timer entrypoint; daily EMA10/20 entry, settled weekly exit)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network-online.target swingtrader-db.service swingtrader-scanner-backfill.service
Wants=network-online.target

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf/executor_retry.py --mode etf
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=120
# Backstop: Type=oneshot defaults TimeoutStartSec to infinity, so pin it — a
# 10:25 trigger is killed by 16:25 even if the retry loop misbehaves. (RuntimeMaxSec
# is ignored for oneshot units.)
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
