[Unit]
Description=S1 Stock Daily Executor (paper #PA368CPXNS13; 10:25 timer entrypoint)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network-online.target swingtrader-db.service swingtrader-scanner-backfill.service
Wants=network-online.target swingtrader-db.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf/cmo_live.py
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=300
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
