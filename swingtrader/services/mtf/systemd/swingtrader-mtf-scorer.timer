[Unit]
Description=MTF v2 Scorer Timer (evening recap — score+slack only, posts the combined MTFS/MTFE/sector/regime message at 16:45 ET; no orders)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service

# Evening analytics recap: scores TODAY's settled close (after the 15:30
# EVENING_CUTOFF in runner.py) and posts the same combined message the 10:25
# executor produces in the morning. Purely informational — save_pending is
# overwritten by the next morning's inline score, so no double execution.

[Timer]
OnCalendar=Mon..Fri *-*-* 16:45:00 America/New_York
# Persistent=false is DELIBERATE — do not "fix" it back to true.
# Persistent means "if this would have fired while the box was off, fire it at the
# next boot." With every timer Persistent=true, an evening power-off (or any reboot
# after the scheduled minute) made ALL of the day's timers due simultaneously at the
# next boot — including legema and mtf-executor, which PLACE ORDERS. That ran the
# order-placers pre-market at 08:45, before prices-load had loaded a single bar, and
# hit Alpaca with ~10 concurrent units.
# The rule now: Persistent=true only where a missed run must still happen (data
# refresh + backup). Where a missed run must be SKIPPED rather than replayed at the
# wrong time — anything that trades or posts a signal — it is false. The readiness
# gate is the backstop, not the schedule: a boot after 10:25 skips the day's MTF run
# instead of trading on data it never verified.
Persistent=false

[Install]
WantedBy=timers.target
