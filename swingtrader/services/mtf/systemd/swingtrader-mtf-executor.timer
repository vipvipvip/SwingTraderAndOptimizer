[Unit]
Description=MTF Top-N Executor Timer (weekdays at 1:00 PM ET)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service

[Timer]
OnCalendar=Mon..Fri *-*-* 13:00:00 America/New_York
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
