[Unit]
Description=MTF Top-N Daily Scorer (Multi-TF rotation — evening analytics)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network-online.target swingtrader-db.service swingtrader-scanner-backfill.service
Wants=network-online.target
Wants=swingtrader-db.service swingtrader-scanner-backfill.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf
# No ExecStartPre data refresh (removed 2026-10-06): scanner-backfill already loads and computes at
# 16:30, and runner.py's readiness gate self-repairs via backfill_all_missing if anything is behind.
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf/runner.py --action score --mode all --strategy emasma
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
