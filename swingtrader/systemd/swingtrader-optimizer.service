# ⛔ DISABLED (2026-09-12): old CHAND strategy (now CoreEW) converted to a pure weekly equal-weight trio
# book (QQQ/VTI/VTV @ equity/3, rebalanced each Friday). No chandelier params
# are used by the executor anymore, so the nightly brute-force parameter grid
# search is dead weight. Service stopped via `sudo systemctl disable --now
# swingtrader-optimizer.timer`; unit files kept in repo for reference only.
[Unit]
Description=SwingTrader Nightly Optimizer (oneshot) (DISABLED - CoreEW is EW-only now)
After=network.target docker.service swingtrader-db.service
Wants=docker.service swingtrader-db.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer
ExecStart=/bin/bash /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/run_nightly.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swingtrader-optimizer
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
