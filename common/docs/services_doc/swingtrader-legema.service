[Unit]
Description=CoreEW LegEMA (variant P20w) Executor - per-leg weekly EMA20 crossover, EW-rebalance among ON legs
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network-online.target swingtrader-db.service
Wants=network-online.target

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/backend
ExecStart=/usr/bin/php /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/backend/artisan trades:execute-leg-ema --span=20
StandardOutput=journal
StandardError=journal
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target