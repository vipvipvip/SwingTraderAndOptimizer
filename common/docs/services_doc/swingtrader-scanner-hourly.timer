[Unit]
Description=SwingTrader intraday hourly sampler (weekdays 09:10-15:10 ET, feeds v2 hourly signals)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service

[Timer]
OnCalendar=Mon..Fri *-*-* 09:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 10:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 11:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 12:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 13:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 14:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 15:10:00 America/New_York
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
