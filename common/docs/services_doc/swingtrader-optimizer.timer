# ⛔ DISABLED (2026-09-12): old CHAND strategy (now CoreEW) converted to a pure weekly equal-weight trio
# book (QQQ/VTI/VTV @ equity/3, rebalanced each Friday). No chandelier params
# are used by the executor anymore, so the nightly brute-force parameter grid
# search is dead weight. Timer stopped via `sudo systemctl disable --now
# swingtrader-optimizer.timer`; unit files kept in repo for reference only.
[Unit]
Description=SwingTrader Nightly Optimizer Timer (DISABLED - CoreEW is EW-only now)
Requires=swingtrader-optimizer.service

[Timer]
OnCalendar=*-*-* 02:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
