[Unit]
Description=SwingTrader Nightly Optimizer (oneshot)
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer
ExecStart=/bin/bash /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/run_nightly.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swingtrader-optimizer
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
