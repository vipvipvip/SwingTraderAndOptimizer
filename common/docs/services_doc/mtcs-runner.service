[Unit]
Description=MTCS Multi-Timeframe Cycle Strategy Signal Service
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service
Wants=swingtrader-db.service

[Service]
Type=simple
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtcs
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtcs/runner.py
Restart=always
RestartSec=30
StandardOutput=append:/var/log/mtcs-runner.log
StandardError=append:/var/log/mtcs-runner.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
