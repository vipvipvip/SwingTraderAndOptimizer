[Unit]
Description=MTF emasma Executor Timer (once/day, 10:25 ET after daily backfill+indicators)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service swingtrader-scanner-backfill.timer

[Timer]
OnCalendar=Mon..Fri *-*-* 10:25:00 America/New_York
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target