[Unit]
Description=MTF v2 Scorer Timer (DISABLED — scoring is done inline by the 13:15 executor; kept for manual/analytics use)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service

# Superseded 2026-08-27: the swingtrader-mtf-executor.service now runs
# `--action score` then `--action execute` inline at 13:15 ET, so a separate
# evening scorer is no longer needed for the live paper account. To re-enable
# this analytics-only recap, set an OnCalendar and add [Install].
#OnCalendar=Mon..Fri *-*-* 16:45:00 America/New_York

[Timer]
# Disabled: no OnCalendar set — running this unit has no schedule.
Persistent=false
