[Unit]
Description=MTF Top-N Daily Scorer (Multi-TF stocks + EMA/SMA ETFs — evening analytics)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service scanner-hourly.service
Wants=swingtrader-db.service scanner-hourly.service

[Service]
Type=oneshot
User=dikesh
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf
ExecStartPre=/home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/.venv/bin/python /home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/services/scripts/populate_tickers.py --timeframe day --workers 10
ExecStartPre=/home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/.venv/bin/python /home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/services/scripts/compute_indicators.py --timeframe day --workers 10
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/optimizer/venv/bin/python3 /home/dikesh/data/dev/SwingTraderAndOptimizer/swingtrader/services/mtf/runner.py --action score --mode all
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
