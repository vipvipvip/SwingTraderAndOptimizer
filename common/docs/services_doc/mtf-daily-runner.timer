[Unit]
Description=MTF Top-N Daily Runner Timer (weekdays at 5:30 PM ET after market close)
Documentation=https://github.com/anomalyco/SwingTraderAndOptimizer
After=network.target swingtrader-db.service

[Timer]
OnCalendar=Mon..Fri *-*-* 08:00:00 America/New_York
OnCalendar=Mon..Fri *-*-* 17:30:00 America/New_York
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
