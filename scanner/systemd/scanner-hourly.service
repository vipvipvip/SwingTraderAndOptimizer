[Unit]
Description=Scanner hourly price capture + indicator computation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/dikesh/data/dev/SwingTraderAndOptimizer/scanner
ExecStartPre=/home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/.venv/bin/python services/scripts/populate_tickers.py --timeframe hour --workers 5
ExecStart=/home/dikesh/data/dev/SwingTraderAndOptimizer/scanner/.venv/bin/python services/scripts/compute_indicators.py --timeframe hour --workers 10

[Install]
WantedBy=timers.target
